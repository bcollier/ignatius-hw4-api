# Copy to .env for local development. On Render, set these in the service's Environment tab.

# Claude, through OpenRouter's Anthropic-compatible endpoint (or set ANTHROPIC_API_KEY instead).
OPENROUTER_API_KEY=
# LLM_MODEL=anthropic/claude-opus-5
# WEB_SEARCH=1
# LLM_MODE=stub            # no model calls; placeholder text for testing

# Premium voices. Leave empty to offer only the free Microsoft voices.
ELEVENLABS_API_KEY=

# Supabase: sign-in, saved retreats and audio storage. Leave empty to run locally
# with no sign-in and files under DATA_DIR.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ALLOWED_EMAILS=

# Free mode for everyone not on ALLOWED_EMAILS: Jetstream2 open models (token from
# the Jetstream chat UI), free voices, FREE_MAX_RETREATS retreats each.
JETSTREAM_API_KEY=
# JETSTREAM_MODELS=llama-4-scout,muse-glimmer
# FREE_MAX_RETREATS=3
# Web research for free-mode deep dives (the server searches, the model writes from the
# results). Any of these; users pick one on the page. SEARCH_PROVIDER is the default.
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
BRAVE_ANSWERS_API_KEY=
FIRECRAWL_API_KEY=
LINKUP_API_KEY=            # Linkup search and deep research
# SEARCH_PROVIDER=brave     # brave | exa | tavily | firecrawl | linkup | linkup_deep | brave_answers
# LOCAL_USER_MODE=free     # local development: preview free mode

# Browser origins allowed to call the API (comma separated).
ALLOWED_ORIGINS=http://localhost:5500,https://bcollier.github.io
